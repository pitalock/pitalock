# Pitalock environment variables.
# Copy this file to .env (gitignored) and fill in real values for local dev.
# For Vercel deployments, set these in the Vercel dashboard.

# -----------------------------------------------------------------------------
# Required
# -----------------------------------------------------------------------------

# Postgres connection string.
# Vercel + Neon integration sets this automatically.
# For local dev: postgresql://user:password@localhost:5432/pitalock
DATABASE_URL=postgresql://user:password@localhost:5432/pitalock

# -----------------------------------------------------------------------------
# Required for first-run bootstrap (SPEC §12)
# -----------------------------------------------------------------------------

# Owner setup token. Auto-generated in production builds and surfaced in
# Vercel deploy logs. For local dev, set this to any random string of 32+ chars.
# Used exactly once to claim the Owner role on first run; consumed afterward.
OWNER_SETUP_TOKEN=

# -----------------------------------------------------------------------------
# Optional: OAuth providers (SPEC §3 — opt-in via env vars)
# Uncomment and fill in to enable the corresponding sign-in button.
# -----------------------------------------------------------------------------

# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# -----------------------------------------------------------------------------
# Optional: Email (SPEC §13)
# Uncomment to enable out-of-band security alert emails.
# Without this, alerts surface in-app on next login only.
# -----------------------------------------------------------------------------

# RESEND_API_KEY=
